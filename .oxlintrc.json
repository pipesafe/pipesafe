{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // typescript-eslint's `strict-type-checked` set, named once rather than
  // re-listed rule by rule. Oxlint has no built-in preset names, so the set
  // is vendored (generated, not curated) at the path below — see the header
  // of that file. This is what the old eslint.config.js meant to extend and
  // did not (#114).
  "extends": [".oxlint/strict-type-checked.json"],
  // Oxlint's default plugin set, spelled out because listing `plugins` at all
  // replaces it.
  "plugins": ["typescript", "oxc", "unicorn"],
  // `correctness` is oxlint's "outright wrong or useless" category and is the
  // nearest thing to the `js/recommended` set this repo used to extend.
  "categories": {
    "correctness": "error"
  },
  // Type-aware rules run through tsgolint (`oxlint-tsgolint`), which builds
  // the TypeScript programs with typescript-go. Without this, every rule in
  // the preset above that needs type information is silently inert — which is
  // exactly what #114 was about. `bun run lint` passes `--type-aware` too, so
  // the flag is there whichever way oxlint is invoked.
  "options": {
    "typeAware": true
  },
  "ignorePatterns": [".claude/**", "**/dist/**", "**/benchmarks/**"],
  // Local overrides on top of the preset. Rules the tree does not pass yet
  // are NOT switched off here — their findings are carried in
  // `oxlint-suppressions.json` so the rules stay on and cannot regress.
  "rules": {
    // `strict-type-checked` enables this with default options; the repo's
    // leading-underscore convention predates it.
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_",
        "args": "after-used"
      }
    ],

    // Use package imports ("@pipesafe/core") rather than relative paths
    // across package boundaries.
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/packages/**"],
            "message": "Use package imports (e.g. \"@pipesafe/core\") instead of relative cross-package imports"
          }
        ]
      }
    ]
  }
}
