{
  "compilerOptions": {
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "module": "ES2022",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "include": [
    "packages/core/examples/**/*.ts",
    "packages/manifold/examples/**/*.ts"
  ]
}
