{
  "name": "pipesafe-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "PipeSafe - Fully type-safe MongoDB aggregation builder for TypeScript projects",
  "author": "Ryan Peggs & Tim Vyas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pipesafe/pipesafe.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "website",
    "website-brand"
  ],
  "packageManager": "bun@1.2.17",
  "engines": {
    "node": "22.11.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@types/bun": "^1.3.2",
    "@types/node": "^24.0.15",
    "lefthook": "^2.0.4",
    "mongodb-memory-server": "^10.2.3",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "ts-morph": "27.0.2",
    "tsdown": "^0.21.5",
    "tsx": "^4.20.3",
    "typescript": "5.9.3",
    "typescript-language-server": "^5.1.3",
    "vitest": "^4.0.15"
  },
  "scripts": {
    "build": "bun run build:packages",
    "build:packages": "tsdown --workspace",
    "build:watch": "tsdown --workspace --watch",
    "clean": "rm -rf packages/*/dist",
    "prepare": "bunx lefthook install",
    "changeset": "changeset",
    "changeset:status": "changeset status --since=origin/main",
    "version": "changeset version && bun install --no-frozen-lockfile",
    "lint": "oxlint --type-aware --max-warnings 0",
    "lint:fix": "oxlint --type-aware --fix --max-warnings 0",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "typecheck:packages": "bun run --filter @pipesafe/core typecheck && bun run --filter @pipesafe/manifold typecheck",
    "budget:check": "cd packages/core && bun run benchmarking/check-instantiation-budget.ts",
    "website:dev": "bun run --filter @pipesafe/website dev",
    "website:build": "bun run --filter @pipesafe/website build",
    "website:preview": "bun run --filter @pipesafe/website preview"
  }
}
